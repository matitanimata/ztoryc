#pragma once
// Generated by CMake from toonz/cmake/ztorycbuild.h.in — do not edit.
// Which commit this build is, and whether it is a PREVIEW (a test build made
// on request, not a release): shown in About, so
// a report can be traced to the exact build it came from.
